# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/travel_booking?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Timezone (IANA format, used for departure reminders)
TIMEZONE=Africa/Kigali

# Default admin (used by seed script)
ADMIN_EMAIL=admin@agency.com
ADMIN_PASSWORD=Admin@12345